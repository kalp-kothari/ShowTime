# Server port
PORT=3000

# Environment: 'development' or 'production'
NODE_ENV=development

# Public base URL used in Stripe redirect URLs.
# Local: http://localhost:3000
# Render: https://your-app-name.onrender.com
BASE_URL=http://localhost:3000

# Neon PostgreSQL connection string (include ?sslmode=require)
DATABASE_URL=postgresql://username:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Secret for signing session cookies — use a long random string (32+ chars).
# Required in production. Fallback dev value is used when omitted locally.
SESSION_SECRET=super_secret_session_key_change_in_production

# Stripe secret key — REQUIRED, no fallback.
# Get your TEST key from: https://dashboard.stripe.com/test/apikeys
# Must start with sk_test_ (test) or sk_live_ (production).
STRIPE_SECRET_KEY=sk_test_your_test_key_here
